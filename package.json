{
  "name": "trove-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:desktop": "pnpm --filter @trove/desktop build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:ui": "pnpm --filter @trove/ui dev",
    "dev:desktop": "pnpm --filter @trove/desktop dev"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
