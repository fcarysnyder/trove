{
  "name": "@trove/core",
  "version": "0.1.0",
  "description": "Trove's engine: a review queue over a folder or git working tree of markdown and HTML files, with comments, batches, locks and a local HTTP API. Node built-ins plus the vendored marked lexer; no other runtime dependency.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "default": "./dist/anchor.js"
    },
    "./marked": {
      "types": "./dist/vendor/marked.esm.d.mts",
      "default": "./dist/vendor/marked.esm.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
