{
  "description": "Tells a Trove server for this project what Claude's turn is doing: its prompt, each tool call, when it needs the user (a permission prompt, a question) and how the turn ended, for the page's Activity. Observe only: prints nothing, decides nothing, and does nothing when no Trove serves the project.",
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/trove.mjs\" signal permission", "timeout": 5 }] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog|idle_prompt", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/trove.mjs\" signal notification", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/trove.mjs\" signal prompt", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/trove.mjs\" signal step", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/trove.mjs\" signal idle", "timeout": 5 }] }
    ]
  }
}
